      <bpmndi:BPMNEdge id="f25_di" bpmnElement="f25"><di:waypoint x="2735" y="275"/><di:waypoint x="2805" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f26_di" bpmnElement="f26"><di:waypoint x="2935" y="275"/><di:waypoint x="2950" y="275"/><di:waypoint x="2950" y="55"/><di:waypoint x="2965" y="55"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f27_di" bpmnElement="f27"><di:waypoint x="3095" y="55"/><di:waypoint x="3172" y="55"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
