# Copy to .env (never commit .env). All values below are the defaults.
# Demo API keys (local only; change them for any shared deployment)
P14_KEY_P24=demo-p24-public
P14_KEY_P12=demo-p12-generation
P14_KEY_EMPLOYEE=demo-employee
P14_KEY_HR=demo-hr-officer
P14_KEY_IT=demo-it-officer
P14_KEY_LEGAL=demo-legal-officer
P14_KEY_DPO=demo-dpo
P14_KEY_RSPP=demo-rspp
P14_KEY_ADMIN=demo-admin
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=p14_passages
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cuda
# RERANKER_MODEL=  (stretch goal S3; unset = no reranker)
SQLITE_PATH=data/processed/p14.sqlite
PRINCIPALS_PATH=config/principals.json
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
DISPLAY_SYSTEM=S2
SHADOW_SYSTEM=B0
# Calibrated on the tuning split by eval/calibrate_threshold.py (see eval/results/calibration.json)
IE_MIN_DENSE=0.837327
IE_MIN_BM25=13.514695
# --- UniBridge (profile: src/p14_search/unibridge_profile.py) ---
# Demo API keys of the UniBridge roles (config/principals_unibridge.json); local only.
UB_KEY_VISITOR=demo-ub-visitor
UB_KEY_STUDENT=demo-ub-student
UB_KEY_SCHOLARSHIP_OFFICE=demo-ub-scholarship-office
UB_KEY_STUDENT_OFFICE=demo-ub-student-office
UB_KEY_INTERNATIONAL_OFFICE=demo-ub-international-office
UB_KEY_ADMIN=demo-ub-admin
# LLM for answers (optional). Empty = extractive answers only, no API calls.
# LLM_PROVIDER = openai | anthropic
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
