@startuml UniBridge_CasiUso
left to right direction
actor "Studente internazionale" as Studente
actor "Visitatore" as Visitatore
actor "Responsabile ufficio" as Ufficio
actor "Amministratore" as Admin
actor "Provider LLM\n(facoltativo)" as LLM
Visitatore --|> Studente
rectangle UniBridge {
  usecase "Fare una domanda\nin 17 lingue" as UC1
  usecase "Vedere fonti e\ntesto originale italiano" as UC2
  usecase "Preparare bozza e-mail\nall'ufficio" as UC3
  usecase "Verificare requisiti\nborsa ERDIS" as UC4
  usecase "Scaricare scadenze .ics" as UC5
  usecase "Caricare un documento" as UC6
  usecase "Approvare un documento" as UC7
  usecase "Cercare passaggi\n(ricerca ibrida)" as UC8
}
Studente --> UC1
Studente --> UC4
Studente --> UC3
UC1 ..> UC8 : <<include>>
UC1 ..> UC2 : <<include>>
UC3 ..> UC1 : <<extend>>
UC5 ..> UC4 : <<extend>>
Ufficio --> UC6
Ufficio --> UC7
Admin --> UC6
Admin --> UC7
UC1 --> LLM
@enduml
