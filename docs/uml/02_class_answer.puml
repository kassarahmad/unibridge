@startuml
!include _style.iuml
title Class diagram - package answer (src/p14_search/answer)
hide circle

package "answer" {

  class AnswerService $ANSWER {
    +search : SearchService
    +llm : LLMClient [0..1]
    +handoff : HandoffService
    +settings : Settings
    +answer(req : AnswerRequest, principal : Principal, request_id : str) : AnswerResponse
    +retrieve(query, lang, principal, k, use_llm, usage) : (hits, insufficient, italian)
    -_extractive(query, italian, sources) : AnswerSentence [*]
    -_generate(query, lang, sources, verify, usage) : (AnswerSentence [*], VerificationReport)
    -_supports(passage, statement, usage) : bool
  }

  class _Usage <<dataclass>> $ANSWER {
    +results : LLMResult [*]
    +add(r : LLMResult) : LLMResult
    +report() : LLMUsage [0..1]
  }

  class "service" as service_mod <<module>> $ANSWER {
    +SYSTEM = "S2"
    +{static} translate_query(llm : LLMClient, query : str) : LLMResult
  }

  class LLMClient $ANSWER {
    +provider : Provider
    +cache_dir : Path [0..1]
    +usage_log : Path [0..1]
    +budget_usd : float
    +price : (float, float) [0..1]
    +name : str {readOnly}
    +complete(system, prompt, max_tokens, purpose) : LLMResult
    +cost(input_tokens, output_tokens) : float [0..1]
    +spent_usd() : float
    -_log(r : LLMResult, purpose, key)
  }

  interface Provider <<Protocol>> $ANSWER {
    +name : str
    +model : str
    +call(system, prompt, max_tokens) : (text, tokens_in, tokens_out)
  }

  class LocalProvider $ANSWER {
    +name = "local"
    +base_url : str
    -client : openai.OpenAI
  }
  class OpenAIProvider $ANSWER {
    +name = "openai"
    -client : openai.OpenAI
  }
  class AnthropicProvider $ANSWER {
    +name = "anthropic"
    -client : anthropic.Anthropic
  }
  class FakeProvider $ANSWER {
    +name = "fake"
    +respond : Callable
    +calls : (system, prompt) [*]
  }

  class LLMResult <<dataclass>> $ANSWER {
    +text : str
    +provider : str
    +model : str
    +input_tokens : int
    +output_tokens : int
    +cost_usd : float [0..1]
    +cached : bool
    +latency_ms : float
  }

  class LLMError <<exception>> $ANSWER
  class BudgetExceeded <<exception>> $ANSWER

  class "llm" as llm_mod <<module>> $ANSWER {
    +TEMPERATURE = 0.0
    +PRICES : dict
    +FREE = (0.0, 0.0)
    +{static} build_llm(settings : Settings, provider : Provider [0..1]) : LLMClient [0..1]
    +{static} read_usage(path : Path) : dict [*]
  }

  class "prompts" as prompts_mod <<module>> $ANSWER {
    +NO_ANSWER = "NO_ANSWER"
    +MAX_PASSAGE_CHARS = 1200
    +ANSWER_SYSTEM, SUPPORT_SYSTEM, TRANSLATE_SYSTEM : str
    +{static} answer_prompt(question, lang, passages) : (system, user)
    +{static} support_prompt(passage, statement) : (system, user)
  }

  class "verifier" as verifier_mod <<module>> $ANSWER {
    +{static} parse_claims(output : str) : (Claim [*], uncited : str [*])
    +{static} verify_citations(output : str, valid_aliases : set) : Verification
    +{static} is_yes(text : str) : bool
  }
  class Claim <<dataclass>> $ANSWER {
    +text : str
    +aliases : str [*]
  }
  class Verification <<dataclass>> $ANSWER {
    +kept : Claim [*]
    +dropped_uncited : str [*]
    +dropped_invalid : Claim [*]
  }

  class "language" as language_mod <<module>> $ANSWER {
    +I_DONT_KNOW, EXTRACTIVE_NOTE : dict
    +HANDOFF_NOTE, OUT_OF_SCOPE_NOTE : dict
    +{static} detect(text : str) : str
  }

  class "flow" as flow_mod <<module>> $ANSWER {
    +STEPS : Step [26]
    +END_ANSWER, END_IDK
    +{static} build_answer_net() : Net
  }
}

class SearchService $RETRIEVAL
class HandoffService $HANDOFF
class Settings $CORE
class Net <<dataclass>> $PROCEDURE
class AnswerResponse $MODELS

AnswerService o--> "0..1" LLMClient : llm
AnswerService o--> "1" SearchService : search
AnswerService o--> "1" HandoffService : handoff
AnswerService --> Settings
AnswerService ..> _Usage : <<create>>
AnswerService ..> prompts_mod : <<use>>
AnswerService ..> verifier_mod : <<use>>
AnswerService ..> language_mod : <<use>>
AnswerService ..> AnswerResponse : <<create>>
AnswerService ..> LLMError : <<catch>>\nextractive fallback
service_mod ..> LLMClient : <<use>>
_Usage o--> "*" LLMResult

LLMClient o--> "1" Provider : provider
LLMClient ..> LLMResult : <<create>>
LLMClient ..> LLMError : <<throw>>
LLMClient ..> BudgetExceeded : <<throw>>
Provider <|.. LocalProvider
Provider <|.. OpenAIProvider
Provider <|.. AnthropicProvider
Provider <|.. FakeProvider
LLMError <|-- BudgetExceeded
llm_mod ..> LLMClient : <<create>>
llm_mod ..> Settings : <<use>>

verifier_mod ..> Verification : <<create>>
Verification o--> "*" Claim
flow_mod ..> Net : <<create>>
HandoffService ..> LLMClient : <<use>>\ntranslation

note right of LLMClient
  complete(): SHA-256 cache key of provider, model,
  max_tokens, temperature, system and prompt;
  cache hit -> no call. Otherwise the spend limit is
  checked (never for the local provider, price 0),
  the provider is called and the usage is logged.
end note

note bottom of LocalProvider
  Any OpenAI-compatible server on the machine:
  LM Studio (port 1234) or Ollama (port 11434).
  No API key, cost 0 USD.
end note

$legend("answer,retrieval,handoff,procedure,core,models")
@enduml
