      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="375" y="47"/><di:waypoint x="390" y="47"/><di:waypoint x="390" y="142"/><di:waypoint x="405" y="142"/></bpmndi:BPMNEdge>
