<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_guida_borsa" targetNamespace="https://unibridge.example/bpmn">
  <collaboration id="collab">
    <participant id="pool" name="UniBridge: Guida alla borsa ERDIS" processRef="guida_borsa"/>
  </collaboration>
  <process id="guida_borsa" name="UniBridge: Guida alla borsa ERDIS" isExecutable="false">
    <laneSet id="lanes">
      <lane id="lane_stud" name="Studente">
        <flowNodeRef>start</flowNodeRef>
        <flowNodeRef>t_dati</flowNodeRef>
        <flowNodeRef>t_vede</flowNodeRef>
        <flowNodeRef>end</flowNodeRef>
      </lane>
      <lane id="lane_api" name="UniBridge (regole fisse, procedure/guide.py)">
        <flowNodeRef>t_post</flowNodeRef>
        <flowNodeRef>g_fork</flowNodeRef>
        <flowNodeRef>r_deadline</flowNodeRef>
        <flowNodeRef>r_isee</flowNodeRef>
        <flowNodeRef>r_ispe</flowNodeRef>
        <flowNodeRef>r_prior</flowNodeRef>
        <flowNodeRef>r_dur</flowNodeRef>
        <flowNodeRef>r_merit</flowNodeRef>
        <flowNodeRef>r_permit</flowNodeRef>
        <flowNodeRef>r_amount</flowNodeRef>
        <flowNodeRef>g_join</flowNodeRef>
        <flowNodeRef>g_fail</flowNodeRef>
        <flowNodeRef>t_ne</flowNodeRef>
        <flowNodeRef>g_check</flowNodeRef>
        <flowNodeRef>t_cwo</flowNodeRef>
        <flowNodeRef>t_el</flowNodeRef>
        <flowNodeRef>g_mv</flowNodeRef>
        <flowNodeRef>t_petri</flowNodeRef>
        <flowNodeRef>t_ics</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="start" name="Apre la Guida alla borsa">
      <outgoing>f1</outgoing>
    </startEvent>
    <userTask id="t_dati" name="Inserisce livello, anno, crediti, ISEE, residenza">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </userTask>
    <task id="t_post" name="Riceve POST /v1/procedure/scholarship">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
    </task>
    <parallelGateway id="g_fork" name="">
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
      <outgoing>f5</outgoing>
      <outgoing>f6</outgoing>
      <outgoing>f7</outgoing>
      <outgoing>f8</outgoing>
      <outgoing>f9</outgoing>
      <outgoing>f10</outgoing>
      <outgoing>f11</outgoing>
    </parallelGateway>
    <task id="r_deadline" name="deadline: domanda entro il 28/8/2026">
      <incoming>f4</incoming>
      <outgoing>f12</outgoing>
    </task>
    <task id="r_isee" name="isee: ISEE fino a 24.000 EUR">
      <incoming>f5</incoming>
      <outgoing>f13</outgoing>
    </task>
    <task id="r_ispe" name="ispe: ISPE fino a 50.000 EUR">
      <incoming>f6</incoming>
      <outgoing>f14</outgoing>
    </task>
    <task id="r_prior" name="prior_degree: nessun titolo dello stesso livello">
      <incoming>f7</incoming>
      <outgoing>f15</outgoing>
    </task>
    <task id="r_dur" name="duration: entro la durata del beneficio">
      <incoming>f8</incoming>
      <outgoing>f16</outgoing>
    </task>
    <task id="r_merit" name="merit: crediti richiesti entro il 10/8/2026">
      <incoming>f9</incoming>
      <outgoing>f17</outgoing>
    </task>
    <task id="r_permit" name="permit: permesso di soggiorno 2026/2027">
      <incoming>f10</incoming>
      <outgoing>f18</outgoing>
    </task>
    <task id="r_amount" name="amount: categoria dell'importo">
      <incoming>f11</incoming>
      <outgoing>f19</outgoing>
    </task>
    <parallelGateway id="g_join" name="">
      <incoming>f12</incoming>
      <incoming>f13</incoming>
      <incoming>f14</incoming>
      <incoming>f15</incoming>
      <incoming>f16</incoming>
      <incoming>f17</incoming>
      <incoming>f18</incoming>
      <incoming>f19</incoming>
      <outgoing>f20</outgoing>
    </parallelGateway>
    <exclusiveGateway id="g_fail" name="Almeno una regola fail?">
      <incoming>f20</incoming>
      <outgoing>f21</outgoing>
      <outgoing>f22</outgoing>
    </exclusiveGateway>
    <task id="t_ne" name="Verdetto: non idoneo (not_eligible)">
      <incoming>f21</incoming>
      <outgoing>f25</outgoing>
    </task>
    <exclusiveGateway id="g_check" name="Almeno una regola check?">
      <incoming>f22</incoming>
      <outgoing>f23</outgoing>
      <outgoing>f24</outgoing>
    </exclusiveGateway>
    <task id="t_cwo" name="Verdetto: verificare con ERDIS (check_with_office)">
      <incoming>f23</incoming>
      <outgoing>f26</outgoing>
    </task>
    <task id="t_el" name="Verdetto: idoneo (eligible)">
      <incoming>f24</incoming>
      <outgoing>f27</outgoing>
    </task>
    <exclusiveGateway id="g_mv" name="">
      <incoming>f25</incoming>
      <incoming>f26</incoming>
      <incoming>f27</incoming>
      <outgoing>f28</outgoing>
    </exclusiveGateway>
    <task id="t_petri" name="Avanza la rete di Petri del bando: passi fatti e successivi">
      <incoming>f28</incoming>
      <outgoing>f29</outgoing>
    </task>
    <task id="t_ics" name="Crea checklist e scadenze in file .ics">
      <incoming>f29</incoming>
      <outgoing>f30</outgoing>
    </task>
    <userTask id="t_vede" name="Vede il verdetto e scarica il file .ics">
      <incoming>f30</incoming>
      <outgoing>f31</outgoing>
    </userTask>
    <endEvent id="end" name="Guida completata">
      <incoming>f31</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="start" targetRef="t_dati"/>
    <sequenceFlow id="f2" sourceRef="t_dati" targetRef="t_post"/>
    <sequenceFlow id="f3" sourceRef="t_post" targetRef="g_fork"/>
    <sequenceFlow id="f4" sourceRef="g_fork" targetRef="r_deadline"/>
    <sequenceFlow id="f5" sourceRef="g_fork" targetRef="r_isee"/>
    <sequenceFlow id="f6" sourceRef="g_fork" targetRef="r_ispe"/>
    <sequenceFlow id="f7" sourceRef="g_fork" targetRef="r_prior"/>
    <sequenceFlow id="f8" sourceRef="g_fork" targetRef="r_dur"/>
    <sequenceFlow id="f9" sourceRef="g_fork" targetRef="r_merit"/>
    <sequenceFlow id="f10" sourceRef="g_fork" targetRef="r_permit"/>
    <sequenceFlow id="f11" sourceRef="g_fork" targetRef="r_amount"/>
    <sequenceFlow id="f12" sourceRef="r_deadline" targetRef="g_join"/>
    <sequenceFlow id="f13" sourceRef="r_isee" targetRef="g_join"/>
    <sequenceFlow id="f14" sourceRef="r_ispe" targetRef="g_join"/>
    <sequenceFlow id="f15" sourceRef="r_prior" targetRef="g_join"/>
    <sequenceFlow id="f16" sourceRef="r_dur" targetRef="g_join"/>
    <sequenceFlow id="f17" sourceRef="r_merit" targetRef="g_join"/>
    <sequenceFlow id="f18" sourceRef="r_permit" targetRef="g_join"/>
    <sequenceFlow id="f19" sourceRef="r_amount" targetRef="g_join"/>
    <sequenceFlow id="f20" sourceRef="g_join" targetRef="g_fail"/>
    <sequenceFlow id="f21" sourceRef="g_fail" targetRef="t_ne" name="sì"/>
    <sequenceFlow id="f22" sourceRef="g_fail" targetRef="g_check" name="no"/>
    <sequenceFlow id="f23" sourceRef="g_check" targetRef="t_cwo" name="sì"/>
    <sequenceFlow id="f24" sourceRef="g_check" targetRef="t_el" name="no"/>
    <sequenceFlow id="f25" sourceRef="t_ne" targetRef="g_mv"/>
    <sequenceFlow id="f26" sourceRef="t_cwo" targetRef="g_mv"/>
    <sequenceFlow id="f27" sourceRef="t_el" targetRef="g_mv"/>
    <sequenceFlow id="f28" sourceRef="g_mv" targetRef="t_petri"/>
    <sequenceFlow id="f29" sourceRef="t_petri" targetRef="t_ics"/>
    <sequenceFlow id="f30" sourceRef="t_ics" targetRef="t_vede"/>
    <sequenceFlow id="f31" sourceRef="t_vede" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collab">
      <bpmndi:BPMNShape id="pool_di" bpmnElement="pool" isHorizontal="true"><dc:Bounds x="30" y="0" width="2278" height="855"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_stud_di" bpmnElement="lane_stud" isHorizontal="true"><dc:Bounds x="60" y="0" width="2248" height="95"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_api_di" bpmnElement="lane_api" isHorizontal="true"><dc:Bounds x="60" y="95" width="2248" height="760"/></bpmndi:BPMNShape>
