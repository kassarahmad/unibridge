<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_flusso_domanda" targetNamespace="https://unibridge.example/bpmn">
  <collaboration id="collab">
    <participant id="pool" name="UniBridge: dalla domanda alla risposta" processRef="flusso_domanda"/>
  </collaboration>
  <process id="flusso_domanda" name="UniBridge: dalla domanda alla risposta" isExecutable="false">
    <laneSet id="lanes">
      <lane id="lane_stud" name="Studente (chat Streamlit)">
        <flowNodeRef>start</flowNodeRef>
        <flowNodeRef>t_invia</flowNodeRef>
        <flowNodeRef>end_401</flowNodeRef>
        <flowNodeRef>t_mostra</flowNodeRef>
        <flowNodeRef>end_ok</flowNodeRef>
      </lane>
      <lane id="lane_api" name="API FastAPI (UniBridge)">
        <flowNodeRef>g_key</flowNodeRef>
        <flowNodeRef>t_lang</flowNodeRef>
        <flowNodeRef>g_tr</flowNodeRef>
        <flowNodeRef>g_trm</flowNodeRef>
        <flowNodeRef>g_ev</flowNodeRef>
        <flowNodeRef>t_idk</flowNodeRef>
        <flowNodeRef>g_llm</flowNodeRef>
        <flowNodeRef>t_estr</flowNodeRef>
        <flowNodeRef>g_out</flowNodeRef>
        <flowNodeRef>t_log</flowNodeRef>
      </lane>
      <lane id="lane_ric" name="Ricerca ibrida (SQLite + Qdrant)">
        <flowNodeRef>g_fork</flowNodeRef>
        <flowNodeRef>t_bm25</flowNodeRef>
        <flowNodeRef>t_dense</flowNodeRef>
        <flowNodeRef>g_join</flowNodeRef>
        <flowNodeRef>t_rrf</flowNodeRef>
        <flowNodeRef>t_s2</flowNodeRef>
      </lane>
      <lane id="lane_llm" name="LLM gpt-4o-mini (facoltativo)">
        <flowNodeRef>t_trad</flowNodeRef>
        <flowNodeRef>t_gen</flowNodeRef>
        <flowNodeRef>t_ver</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="start" name="Domanda scritta nella chat">
      <outgoing>f1</outgoing>
    </startEvent>
    <userTask id="t_invia" name="Invia la domanda (POST /v1/answer con X-API-Key)">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </userTask>
    <exclusiveGateway id="g_key" name="Chiave API valida?">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <outgoing>f4</outgoing>
    </exclusiveGateway>
    <endEvent id="end_401" name="Accesso negato (401)">
      <incoming>f3</incoming>
    </endEvent>
    <task id="t_lang" name="Riconosce il ruolo e rileva la lingua">
      <incoming>f4</incoming>
      <outgoing>f5</outgoing>
    </task>
    <parallelGateway id="g_fork" name="">
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
      <outgoing>f7</outgoing>
    </parallelGateway>
    <task id="t_bm25" name="BM25: parole chiave su SQLite FTS5">
      <incoming>f6</incoming>
      <outgoing>f8</outgoing>
    </task>
    <task id="t_dense" name="E5: vettore della domanda e ricerca su Qdrant">
      <incoming>f7</incoming>
      <outgoing>f9</outgoing>
    </task>
    <parallelGateway id="g_join" name="">
      <incoming>f8</incoming>
      <incoming>f9</incoming>
      <outgoing>f10</outgoing>
    </parallelGateway>
    <task id="t_rrf" name="Fusione RRF (k = 60) con filtro permessi">
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
    </task>
    <exclusiveGateway id="g_tr" name="Lingua non italiana e LLM attivo?">
      <incoming>f11</incoming>
      <outgoing>f12</outgoing>
      <outgoing>f15</outgoing>
    </exclusiveGateway>
    <task id="t_trad" name="Traduce la domanda in italiano">
      <incoming>f12</incoming>
      <outgoing>f13</outgoing>
    </task>
    <task id="t_s2" name="Seconda ricerca ibrida sulla traduzione + RRF">
      <incoming>f13</incoming>
      <outgoing>f14</outgoing>
    </task>
    <exclusiveGateway id="g_trm" name="">
      <incoming>f14</incoming>
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="g_ev" name="Evidenza sopra la soglia calibrata?">
      <incoming>f16</incoming>
      <outgoing>f17</outgoing>
      <outgoing>f18</outgoing>
    </exclusiveGateway>
    <task id="t_idk" name="Non lo so + bozza e-mail all'ufficio (handoff)">
      <incoming>f17</incoming>
      <outgoing>f24</outgoing>
    </task>
    <exclusiveGateway id="g_llm" name="LLM configurato?">
      <incoming>f18</incoming>
      <outgoing>f19</outgoing>
      <outgoing>f20</outgoing>
    </exclusiveGateway>
    <task id="t_estr" name="Risposta estrattiva: copia le frasi migliori">
      <incoming>f19</incoming>
      <outgoing>f23</outgoing>
    </task>
    <task id="t_gen" name="Scrive la risposta solo dai passaggi P1..Pk">
      <incoming>f20</incoming>
      <outgoing>f21</outgoing>
    </task>
    <task id="t_ver" name="Verificatore: elimina le frasi non supportate">
      <incoming>f21</incoming>
      <outgoing>f22</outgoing>
    </task>
    <exclusiveGateway id="g_out" name="">
      <incoming>f22</incoming>
      <incoming>f23</incoming>
      <incoming>f24</incoming>
      <outgoing>f25</outgoing>
    </exclusiveGateway>
    <task id="t_log" name="Salva la domanda in query_log (SQLite)">
      <incoming>f25</incoming>
      <outgoing>f26</outgoing>
    </task>
    <userTask id="t_mostra" name="Legge risposta, fonti e originale italiano">
      <incoming>f26</incoming>
      <outgoing>f27</outgoing>
    </userTask>
    <endEvent id="end_ok" name="Risposta ricevuta">
      <incoming>f27</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="start" targetRef="t_invia"/>
    <sequenceFlow id="f2" sourceRef="t_invia" targetRef="g_key"/>
    <sequenceFlow id="f3" sourceRef="g_key" targetRef="end_401" name="no"/>
    <sequenceFlow id="f4" sourceRef="g_key" targetRef="t_lang" name="sì"/>
    <sequenceFlow id="f5" sourceRef="t_lang" targetRef="g_fork"/>
    <sequenceFlow id="f6" sourceRef="g_fork" targetRef="t_bm25"/>
    <sequenceFlow id="f7" sourceRef="g_fork" targetRef="t_dense"/>
    <sequenceFlow id="f8" sourceRef="t_bm25" targetRef="g_join"/>
    <sequenceFlow id="f9" sourceRef="t_dense" targetRef="g_join"/>
    <sequenceFlow id="f10" sourceRef="g_join" targetRef="t_rrf"/>
    <sequenceFlow id="f11" sourceRef="t_rrf" targetRef="g_tr"/>
    <sequenceFlow id="f12" sourceRef="g_tr" targetRef="t_trad" name="sì"/>
    <sequenceFlow id="f13" sourceRef="t_trad" targetRef="t_s2"/>
    <sequenceFlow id="f14" sourceRef="t_s2" targetRef="g_trm"/>
    <sequenceFlow id="f15" sourceRef="g_tr" targetRef="g_trm" name="no"/>
    <sequenceFlow id="f16" sourceRef="g_trm" targetRef="g_ev"/>
    <sequenceFlow id="f17" sourceRef="g_ev" targetRef="t_idk" name="no"/>
    <sequenceFlow id="f18" sourceRef="g_ev" targetRef="g_llm" name="sì"/>
    <sequenceFlow id="f19" sourceRef="g_llm" targetRef="t_estr" name="no (oggi)"/>
    <sequenceFlow id="f20" sourceRef="g_llm" targetRef="t_gen" name="sì"/>
    <sequenceFlow id="f21" sourceRef="t_gen" targetRef="t_ver"/>
    <sequenceFlow id="f22" sourceRef="t_ver" targetRef="g_out"/>
    <sequenceFlow id="f23" sourceRef="t_estr" targetRef="g_out"/>
    <sequenceFlow id="f24" sourceRef="t_idk" targetRef="g_out"/>
    <sequenceFlow id="f25" sourceRef="g_out" targetRef="t_log"/>
    <sequenceFlow id="f26" sourceRef="t_log" targetRef="t_mostra"/>
    <sequenceFlow id="f27" sourceRef="t_mostra" targetRef="end_ok"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collab">
      <bpmndi:BPMNShape id="pool_di" bpmnElement="pool" isHorizontal="true"><dc:Bounds x="30" y="0" width="3238" height="770"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_stud_di" bpmnElement="lane_stud" isHorizontal="true"><dc:Bounds x="60" y="0" width="3208" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_api_di" bpmnElement="lane_api" isHorizontal="true"><dc:Bounds x="60" y="220" width="3208" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_ric_di" bpmnElement="lane_ric" isHorizontal="true"><dc:Bounds x="60" y="440" width="3208" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_llm_di" bpmnElement="lane_llm" isHorizontal="true"><dc:Bounds x="60" y="660" width="3208" height="110"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="132" y="37" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_invia_di" bpmnElement="t_invia"><dc:Bounds x="245" y="19" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_key_di" bpmnElement="g_key" isMarkerVisible="true"><dc:Bounds x="445" y="250" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_401_di" bpmnElement="end_401"><dc:Bounds x="612" y="147" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_lang_di" bpmnElement="t_lang"><dc:Bounds x="565" y="239" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_fork_di" bpmnElement="g_fork"><dc:Bounds x="765" y="470" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_bm25_di" bpmnElement="t_bm25"><dc:Bounds x="885" y="459" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_dense_di" bpmnElement="t_dense"><dc:Bounds x="885" y="569" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_join_di" bpmnElement="g_join"><dc:Bounds x="1085" y="470" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_rrf_di" bpmnElement="t_rrf"><dc:Bounds x="1205" y="459" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_tr_di" bpmnElement="g_tr" isMarkerVisible="true"><dc:Bounds x="1405" y="250" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_trad_di" bpmnElement="t_trad"><dc:Bounds x="1525" y="679" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_s2_di" bpmnElement="t_s2"><dc:Bounds x="1685" y="569" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_trm_di" bpmnElement="g_trm" isMarkerVisible="true"><dc:Bounds x="1885" y="250" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_ev_di" bpmnElement="g_ev" isMarkerVisible="true"><dc:Bounds x="2045" y="250" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_idk_di" bpmnElement="t_idk"><dc:Bounds x="2165" y="349" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_llm_di" bpmnElement="g_llm" isMarkerVisible="true"><dc:Bounds x="2205" y="250" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_estr_di" bpmnElement="t_estr"><dc:Bounds x="2325" y="239" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_gen_di" bpmnElement="t_gen"><dc:Bounds x="2325" y="679" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_ver_di" bpmnElement="t_ver"><dc:Bounds x="2485" y="679" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_out_di" bpmnElement="g_out" isMarkerVisible="true"><dc:Bounds x="2685" y="250" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_log_di" bpmnElement="t_log"><dc:Bounds x="2805" y="239" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_mostra_di" bpmnElement="t_mostra"><dc:Bounds x="2965" y="19" width="130" height="72"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="3172" y="37" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="168" y="55"/><di:waypoint x="245" y="55"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="375" y="55"/><di:waypoint x="410" y="55"/><di:waypoint x="410" y="275"/><di:waypoint x="445" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="495" y="275"/><di:waypoint x="553" y="275"/><di:waypoint x="553" y="165"/><di:waypoint x="612" y="165"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="495" y="275"/><di:waypoint x="565" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="695" y="275"/><di:waypoint x="730" y="275"/><di:waypoint x="730" y="495"/><di:waypoint x="765" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="815" y="495"/><di:waypoint x="885" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="815" y="495"/><di:waypoint x="850" y="495"/><di:waypoint x="850" y="605"/><di:waypoint x="885" y="605"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="1015" y="495"/><di:waypoint x="1085" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1015" y="605"/><di:waypoint x="1050" y="605"/><di:waypoint x="1050" y="495"/><di:waypoint x="1085" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1135" y="495"/><di:waypoint x="1205" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="1335" y="495"/><di:waypoint x="1370" y="495"/><di:waypoint x="1370" y="275"/><di:waypoint x="1405" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="1455" y="275"/><di:waypoint x="1490" y="275"/><di:waypoint x="1490" y="715"/><di:waypoint x="1525" y="715"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1655" y="715"/><di:waypoint x="1670" y="715"/><di:waypoint x="1670" y="605"/><di:waypoint x="1685" y="605"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1815" y="605"/><di:waypoint x="1850" y="605"/><di:waypoint x="1850" y="275"/><di:waypoint x="1885" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="1455" y="275"/><di:waypoint x="1885" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f16_di" bpmnElement="f16"><di:waypoint x="1935" y="275"/><di:waypoint x="2045" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f17_di" bpmnElement="f17"><di:waypoint x="2095" y="275"/><di:waypoint x="2130" y="275"/><di:waypoint x="2130" y="385"/><di:waypoint x="2165" y="385"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f18_di" bpmnElement="f18"><di:waypoint x="2095" y="275"/><di:waypoint x="2205" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f19_di" bpmnElement="f19"><di:waypoint x="2255" y="275"/><di:waypoint x="2325" y="275"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f20_di" bpmnElement="f20"><di:waypoint x="2255" y="275"/><di:waypoint x="2290" y="275"/><di:waypoint x="2290" y="715"/><di:waypoint x="2325" y="715"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f21_di" bpmnElement="f21"><di:waypoint x="2455" y="715"/><di:waypoint x="2485" y="715"/></bpmndi:BPMNEdge>
