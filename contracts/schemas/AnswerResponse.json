{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p14.example/contracts/v1/AnswerResponse.json",
  "$defs": {
    "AnswerSentence": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "passage_ids": {
          "description": "Passages cited by this sentence (empty = uncited, shown only in mode 'llm').",
          "items": {
            "type": "string"
          },
          "title": "Passage Ids",
          "type": "array"
        },
        "supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Result of the support check (null = not checked).",
          "title": "Supported"
        }
      },
      "required": [
        "text",
        "passage_ids"
      ],
      "title": "AnswerSentence",
      "type": "object"
    },
    "Citation": {
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "title": "Document Version",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section heading, e.g. 'Art. 18'.",
          "title": "Section"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based page for paginated formats (PDF).",
          "title": "Page"
        },
        "char_start": {
          "description": "Offset in the parsed document text.",
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "title": "Char End",
          "type": "integer"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "document_id",
        "document_version",
        "title",
        "char_start",
        "char_end"
      ],
      "title": "Citation",
      "type": "object"
    },
    "HandoffDraft": {
      "properties": {
        "office_id": {
          "enum": [
            "scholarship",
            "student_office",
            "international"
          ],
          "title": "Office Id",
          "type": "string"
        },
        "office_name": {
          "title": "Office Name",
          "type": "string"
        },
        "channel": {
          "enum": [
            "email",
            "srm_ticket",
            "desk"
          ],
          "title": "Channel",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Recipient address, only when published in the corpus; null otherwise.",
          "title": "To"
        },
        "how_to_send": {
          "description": "How the student can contact the office (from the official documents).",
          "title": "How To Send",
          "type": "string"
        },
        "contact_source": {
          "description": "Document that publishes the contact channel.",
          "title": "Contact Source",
          "type": "string"
        },
        "rule": {
          "description": "Why this office was chosen (rule table config/handoff_offices.json).",
          "title": "Rule",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "description": "Formal Italian text. Placeholders [..] are for the student; nothing personal is filled in.",
          "title": "Body",
          "type": "string"
        },
        "question_original": {
          "title": "Question Original",
          "type": "string"
        },
        "question_italian": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Italian translation of the question (LLM), null if not available.",
          "title": "Question Italian"
        },
        "translated_by_llm": {
          "title": "Translated By Llm",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/HandoffSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "sent": {
          "default": false,
          "description": "Always false: UniBridge never sends messages, the student does.",
          "title": "Sent",
          "type": "boolean"
        }
      },
      "required": [
        "office_id",
        "office_name",
        "channel",
        "to",
        "how_to_send",
        "contact_source",
        "rule",
        "subject",
        "body",
        "question_original",
        "question_italian",
        "translated_by_llm",
        "sources"
      ],
      "title": "HandoffDraft",
      "type": "object"
    },
    "HandoffResponse": {
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "language": {
          "enum": [
            "it",
            "en",
            "ar"
          ],
          "title": "Language",
          "type": "string"
        },
        "out_of_scope": {
          "description": "True when no office matches the question: no draft is produced.",
          "title": "Out Of Scope",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/HandoffDraft"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request_id",
        "language",
        "out_of_scope",
        "message",
        "draft"
      ],
      "title": "HandoffResponse",
      "type": "object"
    },
    "HandoffSource": {
      "properties": {
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        }
      },
      "required": [
        "passage_id",
        "title",
        "section",
        "page",
        "source_url"
      ],
      "title": "HandoffSource",
      "type": "object"
    },
    "LLMUsage": {
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "calls": {
          "title": "Calls",
          "type": "integer"
        },
        "cached_calls": {
          "title": "Cached Calls",
          "type": "integer"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Estimated cost of the non-cached calls (price table in answer/llm.py).",
          "title": "Cost Usd"
        }
      },
      "required": [
        "provider",
        "model",
        "calls",
        "cached_calls",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "title": "LLMUsage",
      "type": "object"
    },
    "SourcePassage": {
      "properties": {
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        },
        "alias": {
          "description": "Short id used in the prompt (P1, P2, ...).",
          "title": "Alias",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "text": {
          "description": "Original passage text (usually Italian), shown next to the answer.",
          "title": "Text",
          "type": "string"
        },
        "citation": {
          "$ref": "#/$defs/Citation"
        }
      },
      "required": [
        "passage_id",
        "alias",
        "rank",
        "text",
        "citation"
      ],
      "title": "SourcePassage",
      "type": "object"
    },
    "VerificationReport": {
      "properties": {
        "generated_sentences": {
          "title": "Generated Sentences",
          "type": "integer"
        },
        "dropped_uncited": {
          "title": "Dropped Uncited",
          "type": "integer"
        },
        "dropped_invalid_citation": {
          "title": "Dropped Invalid Citation",
          "type": "integer"
        },
        "dropped_unsupported": {
          "title": "Dropped Unsupported",
          "type": "integer"
        },
        "support_checked": {
          "title": "Support Checked",
          "type": "boolean"
        }
      },
      "required": [
        "generated_sentences",
        "dropped_uncited",
        "dropped_invalid_citation",
        "dropped_unsupported",
        "support_checked"
      ],
      "title": "VerificationReport",
      "type": "object"
    },
    "Versions": {
      "properties": {
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "chunker_version": {
          "title": "Chunker Version",
          "type": "string"
        },
        "embedding_model": {
          "title": "Embedding Model",
          "type": "string"
        },
        "reranker_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reranker Model"
        },
        "index_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Index Snapshot Id"
        }
      },
      "required": [
        "pipeline_version",
        "chunker_version",
        "embedding_model",
        "reranker_model",
        "index_snapshot_id"
      ],
      "title": "Versions",
      "type": "object"
    }
  },
  "properties": {
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "language": {
      "enum": [
        "it",
        "en",
        "ar"
      ],
      "title": "Language",
      "type": "string"
    },
    "mode": {
      "enum": [
        "llm_verified",
        "llm",
        "extractive",
        "insufficient_evidence"
      ],
      "title": "Mode",
      "type": "string"
    },
    "answer_text": {
      "description": "Sentences joined, without citation markers; empty for 'I don't know'.",
      "title": "Answer Text",
      "type": "string"
    },
    "sentences": {
      "items": {
        "$ref": "#/$defs/AnswerSentence"
      },
      "title": "Sentences",
      "type": "array"
    },
    "sources": {
      "description": "Passages given to the answer step, in rank order, with citations.",
      "items": {
        "$ref": "#/$defs/SourcePassage"
      },
      "title": "Sources",
      "type": "array"
    },
    "insufficient_evidence": {
      "description": "True when the answer is 'I don't know'.",
      "title": "Insufficient Evidence",
      "type": "boolean"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Note in the user's language ('I don't know', extractive note, fallback).",
      "title": "Message"
    },
    "handoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/HandoffResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "llm": {
      "anyOf": [
        {
          "$ref": "#/$defs/LLMUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retrieval_system": {
      "title": "Retrieval System",
      "type": "string"
    },
    "query_italian": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "LLM translation of the query used as a second retrieval query.",
      "title": "Query Italian"
    },
    "latency_ms": {
      "title": "Latency Ms",
      "type": "number"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    }
  },
  "required": [
    "request_id",
    "query",
    "language",
    "mode",
    "answer_text",
    "sentences",
    "sources",
    "insufficient_evidence",
    "retrieval_system",
    "latency_ms",
    "versions"
  ],
  "title": "AnswerResponse",
  "type": "object"
}
